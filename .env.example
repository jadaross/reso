# Injected automatically by the Neon integration on Vercel. Locally, copy these
# from the Neon dashboard into .env.local.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Signs the identity and Admin-unlock cookies. Any long random string.
#   openssl rand -base64 48
SESSION_SECRET=

# VAPID keys for Web Push. Generate once with:
#   pnpm exec web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret Vercel Cron sends as `Authorization: Bearer <token>`.
CRON_SECRET=
